        "titre": { "type": "heading", "settings": { "text": "100 000+ clientes heureuses adorent leurs sacs", "heading_tag": "h2" } },
        "stars": { "type": "text", "settings": { "content": "<p><strong>⭐⭐⭐⭐⭐ Excellent · 4,9 sur 5</strong><br/>Basé sur 15 000+ avis vérifiés</p>" } }
      },
      "block_order": ["sub", "titre", "stars"],
      "settings": { "full_width": false, "text_alignment": "center", "text_alignment_mobile": "center", "background": "#ffffff", "background_gradient": "", "text_color": "#0B1F3A", "heading_color": "", "heading_gradient": "" }
