    "reviews": {
      "type": "testimonials",
      "blocks": {
        "r1": { "type": "testimonial", "settings": { "content": "\"J'ai commandé le panier à linge motif chouette pour ma salle de bain. Il est encore plus beau en vrai qu'en photo ! La qualité du piqué est impressionnante. Je vais en recommander un autre.\"", "author": "Marie-Claire W. — Lyon", "show_rating": true, "rating": 5 } },
        "r2": { "type": "testimonial", "settings": { "content": "\"Magnifique sac artisanal motif chat sur les livres. Reçu en 9 jours, emballage soigné. Tout le monde me demande où je l'ai trouvé. Lucie fait un travail exceptionnel.\"", "author": "Sophie D. — Bordeaux", "show_rating": true, "rating": 5 } },
        "r3": { "type": "testimonial", "settings": { "content": "\"Mon troisième achat chez Les Sacs de Lucie Paris. Je ne commande plus ailleurs. La qualité est toujours au rendez-vous et le service client répond vraiment dans la journée.\"", "author": "Patricia G. — Toulouse", "show_rating": true, "rating": 5 } },
        "r4": { "type": "testimonial", "settings": { "content": "\"Offert à ma mère pour son anniversaire. Elle a pleuré tellement c'était beau ! Le sac de voyage avec les chats dans les fleurs est une vraie œuvre d'art. Merci Lucie !\"", "author": "Isabelle M. — Marseille", "show_rating": true, "rating": 5 } },
        "r5": { "type": "testimonial", "settings": { "content": "\"Hésitais à commander en ligne mais je ne regrette absolument pas. Livraison rapide, qualité irréprochable. La trousse de maquillage tient bien fermée et les motifs sont superbes.\"", "author": "Nathalie R. — Nantes", "show_rating": true, "rating": 5 } },
        "r6": { "type": "testimonial", "settings": { "content": "\"Le cabas matelassé est parfait pour faire mes courses. Solide, spacieux et tellement joli. Les gens me font des compliments à chaque fois que je l'utilise. Je suis fan !\"", "author": "Françoise L. — Paris", "show_rating": true, "rating": 5 } }
      },
      "block_order": ["r1", "r2", "r3", "r4", "r5", "r6"],
      "settings": { "full_width": true, "subheading": "", "title": "", "stack_testimonials": false, "background": "#ffffff", "background_gradient": "", "text_color": "#0B1F3A", "heading_color": "", "heading_gradient": "", "testimonial_card_background": "#faf8f5", "testimonial_card_text_color": "#0B1F3A" }
    },
