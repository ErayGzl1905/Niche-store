    "brand-story": {
      "type": "rich-text",
      "blocks": {
        "sub": { "type": "subheading", "settings": { "text": "NOTRE HISTOIRE" } },
        "titre": { "type": "heading", "settings": { "text": "Chaque point raconte une histoire", "heading_tag": "h2" } },
        "texte": { "type": "text", "settings": { "content": "<p>Je m'appelle Lucie. Depuis mon atelier parisien, je confectionne et sélectionne des sacs piqués main depuis plus de vingt ans. Des chats sur les livres, des fleurs sauvages, des chouettes dans la nuit — chaque motif est une histoire que je voulais voir portée dans la rue. Aujourd'hui, je fais une grande vente pour faire de la place aux nouvelles créations. Profitez-en, ces prix ne durent pas.</p>" } },
        "btn": { "type": "button", "settings": { "button_label": "Notre histoire", "button_link": "shopify://pages/notre-histoire", "secondary_button_label": "", "secondary_button_link": "" } }
      },
      "block_order": ["sub", "titre", "texte", "btn"],
      "settings": { "full_width": false, "text_alignment": "center", "text_alignment_mobile": "center", "background": "#f5f0eb", "background_gradient": "", "text_color": "#0B1F3A", "heading_color": "#5a3e28", "heading_gradient": "" }
    },
