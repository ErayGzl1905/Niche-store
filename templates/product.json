          "type": "collapsible_text",
          "settings": {
            "title": "Livraison gratuite",
            "content": "<p><strong>Livraison gratuite sur toutes les commandes, sans minimum.</strong> Chaque colis est suivi : vous recevez votre lien de suivi par courriel dès l'expédition. Délai approximatif : 7 à 12 jours ouvrables.</p>",
            "page": ""
          }
        },
        "collapsible_text_gTEktt": {
          "type": "collapsible_text",
          "settings": {
            "title": "30 jours pour changer d'idée",
            "content": "<p>Vous avez 30 jours suivant la réception pour nous retourner l'article : remboursement complet ou échange de taille ou de couleur. Contactez-nous simplement par courriel.</p>",
            "page": ""
          }
        },
