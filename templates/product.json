        "liquid_kEnVLK": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- liquid\n  assign r = product.metafields.reviews.rating.value\n  assign rc = product.metafields.reviews.rating_count.value | default: 0\n-%}\n{%- if rc > 0 -%}\n<a href=\"#avis\" class=\"fr-rating\">\n  <span class=\"fr-stars\">★★★★★</span>\n  <span class=\"fr-rating-text\"><strong>{{ r.rating | round: 1 }}/5</strong> · {{ rc }} avis clients</span>\n</a>\n<style>\n  .fr-rating{display:inline-flex;align-items:center;gap:8px;margin-bottom:10px;color:#111;text-decoration:none;font-size:13px}\n  .fr-stars{letter-spacing:1px;font-size:14px}\n</style>\n{%- endif -%}"
          }
        },
        "liquid_4qEaAH": {
          "type": "liquid",
          "disabled": false,
          "settings": {
            "liquid": "{%- assign v = product.selected_or_first_available_variant -%}\n{%- if v.inventory_management == 'shopify' and v.inventory_quantity > 0 and v.inventory_quantity <= 10 -%}\n<p class=\"qc-stock\"><span class=\"qc-stock__dot\"></span>Faites vite! Plus que <strong>{{ v.inventory_quantity }}</strong> en stock</p>\n{%- endif -%}"
          }
        },
