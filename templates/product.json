        "liquid_dY3PV8": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "<script>\n(function(){\n  function place(){\n    var wrap = document.querySelector('.sa-wrap');\n    var picker = document.querySelector('variant-picker, .variant-picker, product-form');\n    if(!wrap || !picker || wrap.getAttribute('data-sa-moved')) return;\n\n    var labels = picker.querySelectorAll('legend, label, .variant-picker__option-label, .form-label, p, span');\n    var target = null;\n    for(var i = 0; i < labels.length; i++){\n      var txt = (labels[i].textContent || '').trim();\n      if(txt.length < 25 && /^(size|maat)/i.test(txt)){\n        target = labels[i].closest('fieldset') || labels[i].parentElement;\n        break;\n      }\n    }\n\n    if(target && target.parentNode){\n      target.parentNode.insertBefore(wrap, target);\n      wrap.setAttribute('data-sa-moved', '1');\n    }\n  }\n  place();\n  document.addEventListener('DOMContentLoaded', place);\n  document.addEventListener('shopify:section:load', place);\n  setTimeout(place, 400);\n  setTimeout(place, 1200);\n})();\n</script>\n</div>"
          }
        },
