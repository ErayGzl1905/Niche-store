        "liquid_TdrFHz": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "<ul class=\"usp-list\" aria-label=\"Shop guarantees\">\n  \n  <li class=\"usp-item\">\n    <img\n      class=\"usp-icon icon-1\"\n      src=\"https://cdn.shopify.com/s/files/1/0741/7321/9048/files/Untitled_design_-_2025-09-30T001855.604_700x_cc2c0eef-ce91-4900-b7b1-52ca0c9f76f6.webp?v=1761134944\"\n      alt=\"\"\n      loading=\"lazy\" decoding=\"async\" />\n    <span class=\"usp-text text-1\">Livraison gratuite avec UPS</span>\n  </li>\n\n  <li class=\"usp-item\">\n    <img\n      class=\"usp-icon icon-2\"\n      src=\"//cdn.shopify.com/s/files/1/0920/3213/9593/files/952397-200.png?v=1743117081\"\n      alt=\"\"\n      loading=\"lazy\" decoding=\"async\" />\n    <span class=\"usp-text text-2\">Retours faciles sous 30 jours</span>\n  </li>\n\n  <li class=\"usp-item\">\n    <img\n      class=\"usp-icon icon-3\" \n      src=\"https://cdn.shopify.com/s/files/1/0920/3213/9593/files/Ontwerp_zonder_titel_17.png?v=1744290507\"\n      alt=\"\"\n      loading=\"lazy\" decoding=\"async\" />\n    <span class=\"usp-text text-3\">Achetez 2, économisez 10% &nbsp;|&nbsp; Achetez 3+, économisez 15%</span>\n  </li>\n\n</ul>\n\n<style>\n  /* --- AFSTELLING: ICOONTJES --- */\n  .icon-1 { transform: translateX(0px); }\n  .icon-2 { transform: translateX(-0.2px); }\n  .icon-3 { transform: translateX(0.7px); }\n\n  /* --- AFSTELLING: TEKST --- */\n  .text-1 { transform: translateX(0px); }\n  .text-2 { transform: translateX(-0.2px); }\n  .text-3 { transform: translateX(-0.3px); }\n\n  /* --- ALGEMENE STIJLEN --- */\n  .usp-list {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 8px; \n    font: inherit;\n    color: inherit;\n  }\n\n  .usp-item {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    line-height: 1.3;\n    font-size: 1rem;\n  }\n\n  .usp-icon {\n    width: 20px;\n    height: 20px;\n    object-fit: contain;\n    flex-shrink: 0;\n    opacity: 0.9;\n  }\n\n  .usp-text {\n    font: inherit;\n    color: inherit;\n    letter-spacing: 0.01em;\n    font-weight: 400;\n    display: inline-block; \n  }\n</style>"
          }
        },
